{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.go": {
      "maxDuration": 60,
      "includeFiles": "{config/config.yaml,rbac_model.conf}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}