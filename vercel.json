{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "cd web && corepack enable && pnpm install --frozen-lockfile",
    "framework": null,
    "buildCommand": "cd web && pnpm build",
    "outputDirectory": "web/dist",
    "functions": {
        "api/index.go": {
            "maxDuration": 60,
            "includeFiles": "config/config.yaml"
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/index" },
        { "source": "/ping", "destination": "/api/index" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
