{
    "buildCommand": "cd web && pnpm install && pnpm build",
    "outputDirectory": "web/dist",
    "functions": {
      "api/index.go": { "maxDuration": 60 }
    },
    "rewrites": [
      { "source": "/api/(.*)", "destination": "/api/index" },
      { "source": "/(.*)", "destination": "/index.html" }
    ]
  }